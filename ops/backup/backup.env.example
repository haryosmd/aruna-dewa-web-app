# Di server: /srv/aruna/backup.env, mode 600, milik root. Dibaca aruna-backup.service.
# Yang ada di sini adalah RAHASIA; nama variabelnya ikut git, nilainya tidak.

# Dead man's switch. Siapa pun yang punya URL ini bisa memalsukan ping sukses, jadi ia rahasia.
# Di healthchecks.io: period 1 hari, grace 6 jam. Itu yang mengubahnya dari sekadar notifikasi
# kegagalan menjadi dead man's switch — timer yang mati, VPS yang mati, atau berkas ini yang
# terhapus semuanya berbunyi sama, tanpa ada satu baris kode pun yang jalan.
HC_URL=

# Check kedua, untuk drill restore bulanan. Di healthchecks.io: period 35 hari, grace 7 hari.
# Drill yang dijadwalkan manusia berhenti terjadi di bulan ketiga; yang ini menghubungi kamu.
# Dipakai ops/backup/drill.sh, yang dijalankan dari laptop — bukan dari server.
HC_DRILL_URL=

# Remote rclone + bucket, mis. aruna-backup:aruna-backup
# Kredensialnya di /root/.config/rclone/rclone.conf dan HANYA boleh Put+List — tanpa Delete.
# Yang menghapus adalah lifecycle rule di sisi bucket (ops/backup/lifecycle.json), yang hanya
# bisa diubah dengan kredensial admin yang tidak pernah ada di mesin ini.
REMOTE=

# Ambang bawah ukuran dump, byte. Bukan "lebih besar dari nol": database kosong juga lebih besar
# dari nol. Naikkan setelah beberapa pelanggan pertama supaya ambangnya tetap bermakna.
MIN_DUMP_BYTES=51200
