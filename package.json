{
  "name": "aruna-dewa",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @aruna/database run generate",
    "db:migrate": "pnpm --filter @aruna/database run migrate",
    "db:deploy": "pnpm --filter @aruna/database run deploy",
    "db:seed": "pnpm --filter @aruna/database run seed",
    "db:local": "node scripts/local-postgres.mjs",
    "test:integration": "tsx --env-file-if-exists=packages/database/.env scripts/api-smoke.ts",
    "media:check": "tsx --env-file-if-exists=apps/api/.env scripts/media-bucket-check.ts",
    "mail:local": "node scripts/local-mail.mjs",
    "capture:dashboard": "tsx --env-file-if-exists=packages/database/.env scripts/capture-dashboard.ts",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "ornament:forge": "node scripts/ornament-forge/forge.mjs",
    "ornament:pack": "node scripts/ornament-pack/pack.mjs",
    "ornament:sheet": "tsx scripts/ornament-forge/lihat.ts",
    "ornament:sheet:serve": "tsx scripts/ornament-forge/lihat.ts --sajikan",
    "ornament:verify": "node scripts/ornament-forge/verify.mjs"
  },
  "devDependencies": {
    "@aruna/contracts": "workspace:*",
    "@aruna/database": "workspace:*",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "sharp": "0.32.6",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  },
  "type": "module"
}
