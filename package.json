{
  "name": "aruna-dewa",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @aruna/database generate",
    "db:migrate": "pnpm --filter @aruna/database migrate",
    "db:seed": "pnpm --filter @aruna/database seed",
    "db:local": "node scripts/local-postgres.mjs",
    "test:integration": "tsx --env-file-if-exists=packages/database/.env scripts/api-smoke.ts",
    "mail:local": "node scripts/local-mail.mjs",
    "capture:dashboard": "tsx --env-file-if-exists=packages/database/.env scripts/capture-dashboard.ts"
  },
  "devDependencies": {
    "@aruna/database": "workspace:*",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "sharp": "0.32.6",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  },
  "type": "module"
}
