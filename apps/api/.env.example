DATABASE_URL=postgresql://aruna:aruna-local-only@127.0.0.1:54329/aruna?schema=public
# Daftar berkoma. Origin loopback otomatis menerima ejaan saudaranya pada port yang
# sama (127.0.0.1, localhost, [::1]); domain produksi tidak pernah dapat alias.
# Entri pertama dipakai untuk tautan yang dikirim: verifikasi email, reset password, redirect OAuth.
WEB_ORIGIN=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:3001
# Alamat bind, bukan alamat yang diumumkan. Kosong berarti 127.0.0.1 — benar di mesin ini.
# Di dalam container bawaan itu berarti loopback container itu sendiri dan proxy di container
# lain menjawab 502 tanpa satu pun baris galat, jadi `compose.prod.yaml` menyetel 0.0.0.0 di
# `environment:`; nilai di berkas ini tidak bisa lagi membatalkannya.
HOST=127.0.0.1
PORT=3001
# Wajib, dan boot ditolak kalau kosong atau masih `development-only-change-me`.
# Di NODE_ENV=production minimal 32 karakter. Bikin satu: openssl rand -base64 48
JWT_SECRET=replace-with-a-32-byte-secret-aruna-dewa
# Berapa hop proxy yang boleh dipercaya untuk `X-Forwarded-For`. 0 = tidak ada proxy di depan
# (nilai bawaan); 1 = tepat satu load balancer. Wajib disetel sadar saat NODE_ENV=production —
# salah setel berarti tiap limiter per-IP dan kolom `Session.ip` melihat satu alamat untuk semua.
TRUST_PROXY=0
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=127.0.0.1
# 1025 = Mailpit lokal. Di produksi **2587**, bukan 587: IDCloudHost men-drop 25/465/587 keluar
# secara diam-diam, jadi permintaannya menggantung sampai timeout alih-alih ditolak seketika, dan
# tidak ada satu pun log yang menyebut kata "port". Resend menyediakan 2587 untuk kasus ini.
# `mail.service.ts` menyetel `secure: port === 465`, jadi 2587 jalan lewat STARTTLS apa adanya.
# Sejak Fase 27 baris ini menolak boot kalau kosong di produksi: nilai bawaannya di kode adalah
# 1025, dan bawaan yang diam adalah cara paling murah kehilangan seluruh email keluar.
SMTP_PORT=1025
# Kosongkan keduanya untuk Mailpit lokal: ia menolak koneksi yang membawa blok auth.
# Di produksi keduanya wajib — tiap relay (Resend, Brevo, SES, Postmark) menuntut AUTH,
# dan separuh terisi diperlakukan sama dengan kosong.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aruna Dewa <noreply@aruna.test>
MEDIA_PROVIDER=local
# Relatif diselesaikan terhadap cwd proses, yaitu `apps/api` — bukan akar repo. Di dalam image
# nilainya di-override jadi absolut oleh compose supaya jatuh tepat di volume `media`.
MEDIA_LOCAL_DIR=./.data/media
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
