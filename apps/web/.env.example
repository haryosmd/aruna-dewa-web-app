# Di produksi berkas ini bernama `web.env` di /srv/aruna, mode 600, ditulis tangan sekali.
#
# Semua yang ada di sini punya nilai cadangan loopback di nuxt.config.ts, dan justru itu yang
# berbahaya: salah setel tidak pernah menggagalkan boot. Situsnya menyala, terlihat benar, dan
# baru salah saat dipakai. Karena itu ketiga NUXT_* di bawah di-override `compose.prod.yaml`
# lewat `environment:` — nilai di berkas ini tidak bisa membatalkannya di produksi. Yang tersisa
# untuk diisi tangan hanyalah kontak publik di bagian bawah.

# Alamat bind Nitro. Nitro bind ke semua antarmuka secara bawaan; baris ini ada supaya satu
# `HOST` yang terselip di sini tidak diam-diam mengubahnya.
HOST=127.0.0.1
PORT=3000

# Dipakai saat render di server, dari dalam jaringan compose. Lewat nama service, bukan lewat
# Caddy: render server tidak perlu keluar-masuk TLS untuk memanggil container tetangganya.
NUXT_API_BASE=http://127.0.0.1:3001/v1

# Dipakai browser, jadi wajib alamat publik. Produksi: https://api.arunadewa.id/v1
NUXT_PUBLIC_API_BASE=http://127.0.0.1:3001/v1

# Asal situs ini sendiri. Yang paling mahal kalau salah:
#   - composables/useGuestLink.ts membangun tautan undangan dari sini. Nilai loopback berarti
#     pelanggan membagikan http://127.0.0.1:3000/i/... ke tamu pernikahannya.
#   - composables/useApi.ts mengirimnya sebagai header `origin` saat render server, dan
#     `webOrigins()` di API hanya menerima WEB_ORIGIN — meleset berarti 403 di tiap halaman
#     dasbor yang dirender server.
#   - canonical di pages/i/[slug].vue, sitemap.xml, dan robots.txt.
# Produksi: https://arunadewa.id
NUXT_PUBLIC_WEB_BASE=http://127.0.0.1:3000

# Kontak publik. Dibiarkan kosong sampai nomor dan akun asli tersedia — lebih baik barisnya
# hilang dari situs daripada mengirim orang ke tujuan palsu.
NUXT_PUBLIC_WHATSAPP=
NUXT_PUBLIC_INSTAGRAM=
NUXT_PUBLIC_EMAIL=halo@arunadewa.id
