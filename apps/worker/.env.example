# Di produksi berkas ini bernama `worker.env` di /srv/aruna, mode 600, ditulis tangan sekali.
#
# Worker hanya melayani satu antrean, `payment-reconcile`, lewat pg-boss di database yang sama
# dengan API. Ia tidak menyajikan HTTP dan tidak punya port.

# Wajib. Worker menolak menyala tanpa ini (apps/worker/src/main.ts:6). Di produksi menunjuk
# service `postgres` di jaringan compose, bukan 127.0.0.1.
DATABASE_URL=postgresql://aruna:aruna-local-only@127.0.0.1:54329/aruna?schema=public

# Dipakai saat memanggil balik API setelah rekonsiliasi. Produksi: http://api:3001 — nama
# service, bukan domain publik; tidak ada alasan trafik internal keluar lewat Caddy.
API_ORIGIN=http://127.0.0.1:3001

# Tanpa MIDTRANS_SERVER_KEY, polling rekonsiliasi tidak pernah berjalan dan worker diam
# (main.ts:21). Itu keadaan yang disengaja selama operator menandai lunas manual — bukan
# kelalaian, dan worker tetap sehat dalam keadaan itu.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
