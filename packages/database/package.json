    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aruna/contracts": "workspace:*",
    "@prisma/client": "^6.16.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
